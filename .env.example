# Local-only database password. Use a secret manager in deployed environments.
POSTGRES_PASSWORD=repository_steward_local

# Prefer GitHub App installation authentication for deployed operation.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# A token is optional for anonymous public scans and required for dashboard writes
# unless complete GitHub App installation credentials are supplied.
GITHUB_TOKEN=
REPOSITORY_STEWARD_ALLOW_ANONYMOUS_READ_FALLBACK=true

DASHBOARD_ISSUE_REPO=
DASHBOARD_ISSUE_NUMBER=
REPOSITORY_STEWARD_SCAN_INTERVAL_MINUTES=720
